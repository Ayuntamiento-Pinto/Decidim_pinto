# See https://help.github.com/articles/ignoring-files for more about ignoring files.

#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

.byebug_history
.rspec-failures

# Ignore public uploads
public/uploads/

# Ignore application configuration
/config/application.yml
/config/application.yml*

# Ignore deploy secrets
/config/deploy.rb
/config/deploy/*
/Capfile

spec/decidim_dummy_app/

/public/packs/
/public/packs-test/
/public/decidim-packs/
/public/sw.js
/public/sw.js.map

node_modules/
storage/

/yarn-error.log
.yarn-integrity
yarn-debug.log*

/config/master.key

# Archivos desactivados / residuales con datos sensibles
*.old.disabled

# Listas de usuarios - nunca al repo
borrarusers.csv*
spam_users.csv*

# Config de túnel (contiene endpoints internos) parece un sistema antiguo de correo.
.qgtunnel*
/bin/qgtunnel*


# Backup de Gemfile
Gemfile.save

# Cache de bundler
/vendor/bundle/

#Instalación mal ubicada de Limesurveys
/public/assets/formularios
/public/formularios

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Archivos renombrados con sufijo de versión antigua
*0.27.10

# Copias antiguas conservadas para diferenciar de la nueva versión
*.OLD
*.old

# Copias de seguridad
*.bak

# Archivos marcados como deshabilitados
*disabled
